# Секреты. Файл мастер-ключа не должен попасть в репозиторий никогда:
# вместе с базой он расшифровывает все сообщения.
secrets/
*.key
.env

# Рабочие данные приложения: база, временные файлы, письма, готовые PDF.
web/var/
web/.venv/

# Сборка C++
ЗИ_ЛР/crypto_cli
ЗИ_ЛР/*.exe
ЗИ_ЛР/*.o
ЗИ_ЛР/*.gch
ЗИ_ЛР/probe
ЗИ_ЛР/_run.sh
ЗИ_ЛР/*.bak

# Закрытые ключи RSA. Открытые части (.n, .e) оставлять можно,
# но .d — это и есть секрет.
ЗИ_ЛР/*.d

__pycache__/
*.pyc

PLAN.md
*.docx